# monitoring/.env — observability stack secrets
# Copy to monitoring/.env and fill in real values.
# ⚠️  Never commit the real .env file.

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Discord Alerts ────────────────────────────────────────────────────────────
# Get from: Discord channel → Edit Channel → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# ── Grafana dashboard links in Discord notifications ──────────────────────────
# Use localhost:3000 for local dev. Change to your public Grafana URL in production.
GRAFANA_URL=http://localhost:9000
