# auth-svc — local development environment
# Copy to .env and fill in real values.
# ⚠️  Never commit the real .env file.

SERVICE_NAME=auth-svc
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
HTTP_PORT=8082

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_auth
DB_USER=auth_svc
DB_PASSWORD=your_password_here
DB_SSLMODE=disable

# JWT — RS256 (auth-svc holds BOTH keys: signs + verifies)
# Generate with: make gen-keys
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=banking-platform
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
JWT_SUBJECT_ENCRYPTION_KEY=

# OpenTelemetry
OTEL_ENABLED=true
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SAMPLING_RATE=1.0

# Rate limiting
RATE_LIMIT_RPS=500
RATE_LIMIT_BURST=1000

# Redis (token store) — running in platform/ on host port 9050
REDIS_ADDR=localhost:9050
REDIS_PASSWORD=your_redis_password

# Feature flags (optional — leave empty to disable, services return defaults)
# Flipt UI + REST: http://localhost:9051
FLIPT_URL=http://localhost:9051
