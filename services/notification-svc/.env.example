# notification-svc environment variables
# Copy to .env and fill in values before running locally.

# ── Service identity ──────────────────────────────────────────────────────────
SERVICE_NAME=notification-svc
SERVICE_VERSION=dev
ENVIRONMENT=local

# ── HTTP server ───────────────────────────────────────────────────────────────
HTTP_PORT=8084
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s
HANDLER_TIMEOUT_SECS=25

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_notifications
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_LOG_LEVEL=silent

# ── NATS JetStream ────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:9053
NATS_CONSUMER=notification-svc-consumer

# ── JWT ───────────────────────────────────────────────────────────────────────
# Base64-encoded PKIX PEM RSA public key (same key as other services).
# Generate: see HANDOFF.md "Key setup" section.
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=banking-platform
# Base64-encoded 32-byte AES-256 key for subject decryption.
JWT_SUBJECT_ENCRYPTION_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SAMPLING_RATE=1.0

# ── Worker pool ───────────────────────────────────────────────────────────────
WORKER_COUNT=5
WORKER_BATCH_SIZE=10
WORKER_POLL_SECS=5
