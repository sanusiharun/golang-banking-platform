# payment-svc environment variables
# Copy to .env and fill in values before running locally.

# ── Service identity ──────────────────────────────────────────────────────────
SERVICE_NAME=payment-svc
SERVICE_VERSION=dev
ENVIRONMENT=local

# ── HTTP server ───────────────────────────────────────────────────────────────
HTTP_PORT=8085
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s
HANDLER_TIMEOUT_SECS=25

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_payments
DB_USER=payment_svc
DB_PASSWORD=payment_svc_pass_local
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_LOG_LEVEL=silent

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:9050
REDIS_PASSWORD=
IDEMPOTENCY_TTL_HOURS=24

# ── NATS JetStream ────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:9053
NATS_CONSUMER=payment-svc-consumer

# ── Account Service ───────────────────────────────────────────────────────────
ACCOUNT_SVC_URL=http://localhost:8081
# API key used by payment-svc to call account-svc as a service account.
# Generate a bp_live_ key in auth-svc and set it here.
ACCOUNT_SVC_API_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Base64-encoded PKIX PEM RSA public key (same key as other services).
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=banking-platform
# Base64-encoded 32-byte AES-256 key for subject decryption.
JWT_SUBJECT_ENCRYPTION_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPS=500
RATE_LIMIT_BURST=1000

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SAMPLING_RATE=1.0
