# account-svc — local development environment
# Copy to .env and fill in real values.
# ⚠️  Never commit the real .env file.

SERVICE_NAME=account-svc
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
HTTP_PORT=8081

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_accounts
DB_USER=account_svc
DB_PASSWORD=your_password_here
DB_SSLMODE=disable

# JWT — RS256 (account-svc holds PUBLIC key ONLY for token verification)
# Copy JWT_PUBLIC_KEY_B64 from services/auth-svc/.env — must match exactly
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=banking-platform
JWT_SUBJECT_ENCRYPTION_KEY=

# OpenTelemetry
OTEL_ENABLED=true
OTEL_LOGS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SAMPLING_RATE=1.0

# Rate limiting
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000

# Feature flags (optional — leave empty to disable, services return defaults)
FLIPT_URL=http://localhost:8082

# Downstream services
AUTH_SVC_URL=http://localhost:8080
